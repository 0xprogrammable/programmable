  "configuration": {
    "type": "record",
    "fields": {
      "everyN": {
        "type": "uint",
        "bits": 32,
        "min": "1",
        "label": "Reward every Nth eligible buy"
      },
      "minimumGrossNative": {
        "type": "uint",
        "bits": 128,
        "min": "1",
        "unit": "wei",
        "label": "Minimum eligible buy",
        "help": "Gross native amount measured by the authenticated engine, before native platform and Creator fees."
      },
      "rewardNative": {
        "type": "uint",
        "bits": 128,
        "min": "1",
        "unit": "wei",
        "label": "Reward per winner"
      },
      "endsAt": {
        "type": "uint",
        "bits": 64,
        "min": "1",
        "unit": "unix-seconds",
        "label": "Rewards end at",
        "help": "Must be strictly after the block timestamp when the instance is constructed."
      },
      "includeInitialBuy": {
        "type": "bool",
        "label": "Count the launcher's initial buy"
      },
      "refundWallet": {
        "type": "address",
        "label": "Unused budget wallet",
        "help": "Required nonzero wallet. Fixed for the instance; only this wallet can reclaim unused funds at or after the end time."
      }
    },
    "required": [
      "everyN",
      "minimumGrossNative",
      "rewardNative",
      "endsAt",
      "includeInitialBuy",
      "refundWallet"
    ]
  },
  "ports": {
    "inputs": {
      "trades": "programmable.module-native-trade@1",
      "budget": "programmable.module-native-budget@1"
    },
    "outputs": {
      "claims": "programmable.module-native-claims@1"
    }
  },
  "constraints": [],
  "management": {
    "summary": "View eligible buys and native rewards, fund the isolated budget, claim ETH, and reclaim unused budget after expiry from the fixed refund wallet.",
    "reads": [
      {
        "id": "qualified-buys",
        "label": "Eligible buys",
        "component": "reward",
        "entrypoint": "qualifiedBuys()",
        "description": "Counts qualifying buy callbacks, including skipped rewards when funding is insufficient."
      },
      {
        "id": "rewarded-buys",
        "label": "Rewards earned",
        "component": "reward",
        "entrypoint": "rewardedBuys()",
        "description": "Number of buyers credited from available funding."
      },
      {
        "id": "available",
        "label": "Budget remaining",
        "component": "vault",
        "entrypoint": "available(bytes32)",
        "description": "Read with the verified instanceId, never a caller-provided arbitrary bucket."
      },
      {
        "id": "claimable",
        "label": "Your ETH claim",
        "component": "vault",
        "entrypoint": "claimable(bytes32,address)",
        "description": "Read with verified instanceId and connected wallet."
      },
      {
        "id": "claimed",
        "label": "Your claimed ETH",
        "component": "vault",
        "entrypoint": "claimed(bytes32,address)",
        "description": "Cumulative paid amount for verified instanceId and connected wallet."
      },
      {
        "id": "refund-wallet",
        "label": "Unused budget wallet",
        "component": "reward",
        "entrypoint": "refundWallet()",
        "description": "Fixed launch configuration; this is separate from the contributor royalty wallet."
      },
      {
        "id": "ends-at",
        "label": "Rewards end at",
        "component": "reward",
        "entrypoint": "endsAt()",
        "description": "Unix seconds. At this exact time buys stop qualifying and unused-budget reclaim becomes available."
      },
      {
        "id": "total-reclaimed",
        "label": "Unused budget returned to claims",
        "component": "reward",
        "entrypoint": "totalReclaimed()",
        "description": "Total unused funds credited to the fixed refund wallet; not the amount already withdrawn."
      }
    ],
    "actions": [
      {
        "id": "reclaim-unused",
        "label": "Reclaim unused budget",
        "component": "reward",
        "entrypoint": "onAction((bytes32,bytes32,bytes32,address,uint64,bytes32),bytes)",
        "description": "Dispatch only via runtime.executeAction as declared in runtime-binding.json. At or after endsAt, move available budget into a backed refundWallet claim; preserve winner claims. Inputs are exactly zero bytes.",
        "role": "refund-wallet",
        "inputs": {
          "type": "record",
          "fields": {},
          "required": []
        }
      }
    ]
  },
