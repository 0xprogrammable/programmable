{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://programmable.market/schemas/classic-module-recipe-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "chainId", "hook", "registry", "baseBuyFeeBps", "baseSellFeeBps", "modules"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "chainId": { "type": "string", "pattern": "^[1-9][0-9]{0,77}$" },
    "hook": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "registry": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "baseBuyFeeBps": { "type": "integer", "minimum": 0, "maximum": 1000, "multipleOf": 100 },
    "baseSellFeeBps": { "type": "integer", "minimum": 0, "maximum": 1000, "multipleOf": 100 },
    "modules": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["versionId", "config", "parameters"],
        "properties": {
          "versionId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "config": { "type": "string", "pattern": "^0x([0-9a-fA-F]{2}){0,256}$" },
          "parameters": { "type": "object", "maxProperties": 8 }
        }
      }
    }
  }
}
