# Required for Privy wallet sign-in. This public App ID comes from the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=

# Required by server routes that verify Privy access tokens.
PRIVY_APP_SECRET=

# Internal Custom Launch session authority. Values are server-only except the
# Privy App ID above. The private Ed25519 key must be stored as a sensitive
# production secret and must not be reused by permit, review, or broker lanes.
PROGRAMMABLE_GITHUB_SESSION_AUTHORITY_AUDIENCE=
PROGRAMMABLE_GITHUB_SESSION_AUTHORITY_KEY_ID=
PROGRAMMABLE_GITHUB_SESSION_AUTHORITY_KEY_EPOCH=
PROGRAMMABLE_GITHUB_SESSION_AUTHORITY_PRIVATE_KEY_PEM=
PROGRAMMABLE_GITHUB_SESSION_AUTHORITY_PUBLIC_KEY_SPKI_SHA256=
PROGRAMMABLE_GITHUB_SESSION_AUTHORITY_WORKLOAD_ISSUER=
PROGRAMMABLE_GITHUB_SESSION_AUTHORITY_WORKLOAD_SUBJECT=
PROGRAMMABLE_GITHUB_SESSION_AUTHORITY_WORKLOAD_KEY_ID=
PROGRAMMABLE_GITHUB_SESSION_AUTHORITY_WORKLOAD_PUBLIC_KEY_PEM=
PROGRAMMABLE_GITHUB_SESSION_AUTHORITY_WORKLOAD_PUBLIC_KEY_SPKI_SHA256=

# Custom Launch website projection target. Use a dedicated PostgreSQL role
# whose only runtime privileges are SELECT and INSERT on the immutable tables.
PROGRAMMABLE_WEBSITE_PROJECTION_DATABASE_URL=
PROGRAMMABLE_WEBSITE_PROJECTION_DATABASE_ROLE=programmable_website_projection_runtime
# Supabase Server root certificate. Literal \n escapes are accepted.
PROGRAMMABLE_WEBSITE_PROJECTION_DATABASE_CA_PEM=
PROGRAMMABLE_APPROVAL_SERVICE_V2_ORIGIN=
# Exact identity reported by the approval service /readyz endpoint.
PROGRAMMABLE_APPROVAL_SERVICE_EXPECTED_PACKAGE_ARTIFACT_HASH=
# Exact deployed service mode: manual_review or autonomous_ai.
PROGRAMMABLE_APPROVAL_SERVICE_EXPECTED_REVIEW_AUTHORITY_MODE=
# Keep Custom Launch closed unless this switch and every authority binding are valid.
PROGRAMMABLE_CUSTOM_LAUNCH_PUBLIC_ENABLED=false
# Inject the exact reviewed Git commit into every immutable release candidate.
PROGRAMMABLE_RELEASE_COMMIT_SHA=
# JSON array of pinned Ed25519 permit signers. Retain old signer entries while
# unexpired permits from their epochs may still be used.
PROGRAMMABLE_LAUNCH_PERMIT_SIGNERS_V2_JSON=
PROGRAMMABLE_WEBSITE_PROJECTION_AUDIENCE=
PROGRAMMABLE_WEBSITE_ENTITLEMENT_TARGET_BINDING_HASH=
PROGRAMMABLE_WEBSITE_CUSTOM_LAUNCH_TARGET_BINDING_HASH=

# Canonical Ethereum Custom Registry V1 public manifest. Keep the explicit
# switch false until every address, runtime code hash and public specification
# pin below is populated from verified deployment evidence. Partial or invalid
# configuration is published fail-closed as prelaunch with null bindings.
PROGRAMMABLE_CUSTOM_REGISTRY_PUBLIC_ENABLED=false
PROGRAMMABLE_CUSTOM_REGISTRY_GENERATION=
PROGRAMMABLE_CUSTOM_REGISTRY_START_BLOCK=
PROGRAMMABLE_CUSTOM_REGISTRY_ADDRESS=
PROGRAMMABLE_CUSTOM_REGISTRY_RUNTIME_CODE_KECCAK256=
PROGRAMMABLE_CUSTOM_PARTNER_FACTORY_REGISTRY_ADDRESS=
PROGRAMMABLE_CUSTOM_PARTNER_FACTORY_REGISTRY_RUNTIME_CODE_KECCAK256=
PROGRAMMABLE_CUSTOM_FEE_POLICY_VERIFIER_ADDRESS=
PROGRAMMABLE_CUSTOM_FEE_POLICY_VERIFIER_RUNTIME_CODE_KECCAK256=
PROGRAMMABLE_CUSTOM_ATOMIC_REGISTRAR_ADDRESS=
PROGRAMMABLE_CUSTOM_ATOMIC_REGISTRAR_RUNTIME_CODE_KECCAK256=
PROGRAMMABLE_CUSTOM_REGISTRY_ABI_IDENTIFIER=
PROGRAMMABLE_CUSTOM_REGISTRY_ABI_URL=
PROGRAMMABLE_CUSTOM_REGISTRY_EVENT_SET_IDENTIFIER=
PROGRAMMABLE_CUSTOM_REGISTRY_EVENT_SET_URL=
PROGRAMMABLE_CUSTOM_REGISTRY_HASH_SPEC_IDENTIFIER=
PROGRAMMABLE_CUSTOM_REGISTRY_HASH_SPEC_URL=
# Optional server-only read-only RPC. When present, registry readiness checks
# chainId and every address/runtimeCodeKeccak256 binding with eth_getCode.
PROGRAMMABLE_CUSTOM_REGISTRY_READINESS_RPC_URL=

# Short-lived Ed25519 workload access tokens issued to the approval service.
PROGRAMMABLE_PROJECTION_WORKLOAD_ISSUER=
PROGRAMMABLE_PROJECTION_WORKLOAD_SUBJECT=
PROGRAMMABLE_PROJECTION_WORKLOAD_KEY_ID=
PROGRAMMABLE_PROJECTION_WORKLOAD_PUBLIC_KEY_PEM=

# Required in production. Use two independent authenticated Ethereum RPCs.
ETHEREUM_RPC_URL=
ETHEREUM_RPC_URL_B=
PROGRAMMABLE_ALCHEMY_MAINNET_RPC_URL=
PROGRAMMABLE_QUICKNODE_MAINNET_RPC_URL=
# Server-only signing key for authenticating raw Alchemy webhook payloads.
# Copy it from the Alchemy webhook dashboard and never expose it via NEXT_PUBLIC_.
ALCHEMY_WEBHOOK_SIGNING_KEY=

# Optional for contract rehearsal. Use a reliable Sepolia RPC before broadcasting.
SEPOLIA_RPC_URL=

# Private durable index storage.
OPS_BLOB_READ_WRITE_TOKEN=

# Public token-image storage used by the upload route.
TOKEN_IMAGE_BLOB_READ_WRITE_TOKEN=

# Server-side Uniswap Trading API access. Never expose this as a
# NEXT_PUBLIC_ variable.
UNISWAP_API_KEY=

# Server-side access to the official Uniswap v4 Ethereum subgraph.
# The endpoint is pinned to this exact Graph subgraph ID and must not
# include the key. Runtime responses must report the reviewed deployment
# QmZsgJLiLQKpb8hxTmQ5LWyrFVvfWzVaL4WK8dfFBn7EeK in _meta.deployment.
UNISWAP_V4_SUBGRAPH_URL=https://gateway.thegraph.com/api/subgraphs/id/DiYPVdygkfjDWhbxGSqAQxwBKmfKnkWQojqeM2rkLb3G
UNISWAP_V4_SUBGRAPH_API_KEY=

# Server-only realtime read-model providers. Keep every indexed route disabled
# until the migrated database, full backfill, parity, reorg and fallback gates
# have passed. The Envio endpoint is public by design; Postgres and Graph
# credentials must never use a NEXT_PUBLIC_ prefix.
PROGRAMMABLE_PROJECTOR_ACTIVE=false
PROGRAMMABLE_MARKET_PROJECTOR_ACTIVE=false
# Server-only HMAC key for QuickNode Streams. Keep the committed example empty;
# set the same 32-1,024 byte secret in Vercel, the protected GitHub production
# environment and the QuickNode webhook security-token field.
PROGRAMMABLE_QUICKNODE_STREAM_SECRET=
PROGRAMMABLE_ENVIO_GRAPHQL_URL=https://indexer.hyperindex.xyz/f6714ef/v1/graphql
PROGRAMMABLE_ENVIO_GRAPHQL_TOKEN=
PROGRAMMABLE_ENVIO_MAXIMUM_BODY_BYTES=131072
# Remote URLs must include an explicit port and sslmode=verify-full.
# Store the downloaded Supabase root certificate as this server-only PEM value.
PROGRAMMABLE_API_READER_DATABASE_URL=
# Operator-only direct connection. This must be the verified
# db.<project-ref>.supabase.co:5432 endpoint with user postgres or the exact
# Supabase CLI JIT user cli_login_postgres, and must never be added to Vercel.
# JIT access is short-lived; the operator verifies membership and SET ROLE postgres.
PROGRAMMABLE_MIGRATOR_DATABASE_URL=
# Cutover-only loopback restore target and its independent trust root. These
# values are never used by the website runtime or committed with credentials.
PROGRAMMABLE_CUTOVER_RESTORE_DATABASE_URL=
PROGRAMMABLE_CUTOVER_RESTORE_SSL_CA_PEM=
# Absolute PostgreSQL 17 client paths for the reviewed offline/restore operator.
PROGRAMMABLE_PG_DUMP_BINARY=
PROGRAMMABLE_PG_RESTORE_BINARY=
PROGRAMMABLE_PSQL_BINARY=
# Dedicated least-privilege login used only to consume signed release-probe nonces.
PROGRAMMABLE_RELEASE_PROBE_DATABASE_URL=
# Writer-only projector connection. It must authenticate as the constrained
# programmable_projector_login role and must never use a NEXT_PUBLIC_ prefix.
PROGRAMMABLE_PROJECTOR_DATABASE_URL=
PROGRAMMABLE_PROJECTOR_RUNTIME_DATABASE_URL=
# Dedicated server-only shadow-reconciler login. It receives only the narrow
# preparity/corpus/commit capabilities, serves the market projector through the
# same private source, and must not reuse a projector or API reader credential.
PROGRAMMABLE_RECONCILER_DATABASE_URL=
# PEM trust root used only by the reconciler database connection.
PROGRAMMABLE_RECONCILER_DATABASE_SSL_CA=
# Every market page is bound to this exact source projector generation.
PROGRAMMABLE_SOURCE_PROJECTOR_VERSION=projector-v1
PROGRAMMABLE_POSTGRES_SSL_CA_PEM=
PROGRAMMABLE_POSTGRES_MAX_CONNECTIONS=2
PROGRAMMABLE_POSTGRES_CONNECT_TIMEOUT_MS=1000
PROGRAMMABLE_POSTGRES_IDLE_TIMEOUT_MS=5000
PROGRAMMABLE_POSTGRES_LOCK_TIMEOUT_MS=250
PROGRAMMABLE_UNISWAP_GRAPH_BASE_URL=https://gateway.thegraph.com
PROGRAMMABLE_UNISWAP_GRAPH_API_KEY=
# Public provenance labels and commitments for the reviewed official Uniswap
# v4 subgraph query/parser contract. These are evidence, never credentials.
PROGRAMMABLE_UNISWAP_GRAPH_REDACTED_IDENTITY=uniswap-v4-official
PROGRAMMABLE_UNISWAP_GRAPH_DEPLOYMENT_COMMITMENT=0x44c8d7127503563653f7f53ea339caa383453e00224a6c33cf95fc29f5c3e35c
PROGRAMMABLE_UNISWAP_GRAPH_SCHEMA_COMMITMENT=0xd0d2087059ca0a7c1e7c633999ff75ea34fcc00d42cee8985a79d0ef76e6813c
# Generated by the reviewed bootstrap plan from the credential-free provider
# endpoint identity. These values must match the exact release commit.
PROGRAMMABLE_ALCHEMY_MAINNET_RPC_ENDPOINT_COMMITMENT=
PROGRAMMABLE_QUICKNODE_MAINNET_RPC_ENDPOINT_COMMITMENT=
# Random server-only secret used to verify route-bound release-probe HMACs.
PROGRAMMABLE_SHADOW_PROBE_TOKEN=

INDEXED_EXPLORE_LIST_READS_ENABLED=false
INDEXED_EXPLORE_TOKEN_READS_ENABLED=false
INDEXED_EXPLORE_CHART_READS_ENABLED=false
INDEXED_CREATOR_PROFILE_READS_ENABLED=false
INDEXED_CLASSIC_V3_PROFILE_READS_ENABLED=false
INDEXED_LAUNCH_LOOKUP_ENABLED=false
INDEXED_PUBLIC_INDEXER_FEED_READS_ENABLED=false
INDEXED_READ_SHADOW_COMPARE_ENABLED=false
INDEXED_READ_REQUIRE_PARITY_ENABLED=true
INDEXED_READ_LIVE_FALLBACK_ENABLED=true

# Exact public identities and reviewed commitments recorded with each
# projector generation. These values are evidence labels, not credentials.
PROGRAMMABLE_PROJECTOR_ENVIO_REDACTED_IDENTITY=envio:production-92f6373
PROGRAMMABLE_PROJECTOR_ENVIO_MIRROR_COMMIT=0a064ec0a32a0e48bf6751fa18f025504267c6b7
PROGRAMMABLE_PROJECTOR_BINDING_MODE=release

# Private token for a staged read-model performance capture. Never expose it
# through a NEXT_PUBLIC_ variable or include it in captured evidence.
PROGRAMMABLE_PERFORMANCE_PROBE_TOKEN=

# Staged-candidate-only SLA probe. Leave false outside the one explicitly
# armed, unaliased Vercel candidate used to prove QuickNode's real retry path.
PROGRAMMABLE_REAL_BLOCK_SLA_FORCE_PROVIDER_RETRY_ONCE=false

# Required by release tooling when publishing and checking source
# verification on Etherscan.
ETHERSCAN_API_KEY=

# Deep V2 read-only deployment simulation and post-deployment receipt capture.
# The two transaction hashes are populated only after a real Mainnet deployment.
DEEP_V2_MAINNET_DEPLOYER=
DEEP_V2_GROWTH_FACTORY_TRANSACTION=
DEEP_V2_LAUNCHER_TRANSACTION=

# Deep V3 deployment simulation and release capture. These values do not
# authorize a broadcast. Keep transaction hashes empty until an explicitly
# approved Mainnet deployment has confirmed.
DEEP_V3_MAINNET_DEPLOYER=
DEEP_V3_MAINNET_TREASURY=
DEEP_V3_MAINNET_START_NONCE=
DEEP_V3_HOOK_SALT=
DEEP_V3_ZAP_PLANNER_TRANSACTION=
DEEP_V3_GROWTH_FACTORY_TRANSACTION=
DEEP_V3_HOOK_FACTORY_TRANSACTION=
DEEP_V3_FEE_HOOK_TRANSACTION=
DEEP_V3_LAUNCHER_TRANSACTION=
DEEP_V3_RELEASE_COMMIT=
# Required by Vercel Cron when refreshing the durable Mainnet index.
CRON_SECRET=

# Immutable protocol-revenue deployment and restricted Vercel keeper. Keep the
# automation disabled until the exact Mainnet deployment, source match, runtime
# code hashes, delegation and private MEV submission path have all been proven.
PROTOCOL_REVENUE_AUTOMATION_ENABLED=false
PROTOCOL_REVENUE_EXECUTOR_ADDRESS=
PROTOCOL_REVENUE_EXECUTOR_CODE_HASH=
# Sensitive server-only value for a disposable keeper that holds gas only.
# Never use the reward, treasury or deployment-wallet key here.
PROTOCOL_REVENUE_KEEPER_PRIVATE_KEY=
PROTOCOL_REVENUE_KEEPER_MAX_GAS_PRICE_GWEI=5
# Optional dedicated Mainnet quorum overrides. When unset, revenue execution
# uses independent dRPC and PublicNode endpoints instead of shared trade RPCs.
PROTOCOL_REVENUE_RPC_URL_A=
PROTOCOL_REVENUE_RPC_URL_B=
# 250 ensures the fixed 0.5% keeper allocation covers the buffered maximum gas
# cost before a cycle can be submitted.
PROTOCOL_REVENUE_KEEPER_MIN_REVENUE_GAS_MULTIPLIER=250
